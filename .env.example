# Flask session signing key. Generate a long random value for each environment.
FLASK_SECRET_KEY=

# Admin credentials (configure only in Vercel Environment Variables for production).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Supabase configuration used by the temporary admin CRUD page.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TEST_TABLE=
SUPABASE_TEST_ID_COLUMN=id

# Permanent fixture archive in Supabase (use the server-side service role key).
SUPABASE_FIXTURES_TABLE=fixtures
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron authorization secret (same value in Vercel Environment Variables).
CRON_SECRET=
